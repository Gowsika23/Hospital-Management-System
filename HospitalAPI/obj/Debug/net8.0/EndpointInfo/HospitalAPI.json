  "components": {
    "schemas": {
      "AppointmentCreateDto": {
        "required": [
          "appointmentDate",
          "appointmentTime",
          "doctorId",
          "patientId",
          "patientName",
          "symptoms"
        ],
        "type": "object",
        "properties": {
          "doctorId": {
            "type": "integer",
            "format": "int32"
          },
          "patientId": {
            "type": "integer",
            "format": "int32"
          },
          "patientName": {
            "minLength": 3,
            "type": "string"
          },
          "appointmentDate": {
            "type": "string",
            "format": "date-time"
          },
          "appointmentTime": {
            "minLength": 1,
            "type": "string"
          },
          "symptoms": {
            "minLength": 5,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "AppointmentStatusUpdateDto": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "DoctorUpsertDto": {
        "required": [
          "availability",
          "department",
          "email",
          "name",
          "qualification",
          "specialization"
        ],
        "type": "object",
        "properties": {
          "name": {
            "minLength": 3,
            "type": "string"
          },
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "specialization": {
            "minLength": 1,
            "type": "string"
          },
          "department": {
            "minLength": 1,
            "type": "string"
          },
          "qualification": {
            "minLength": 1,
            "type": "string"
          },
          "availability": {
            "minLength": 1,
            "type": "string"
          },
          "consultationFee": {
            "maximum": 10000,
            "minimum": 100,
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "LoginRequestDto": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "MedicalRecordUpsertDto": {
        "required": [
          "diagnosis",
          "doctorId",
          "patientId",
          "prescription"
        ],
        "type": "object",
        "properties": {
          "doctorId": {
            "type": "integer",
            "format": "int32"
          },
          "patientId": {
            "type": "integer",
            "format": "int32"
          },
          "appointmentId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "diagnosis": {
            "minLength": 3,
            "type": "string"
          },
          "prescription": {
            "minLength": 3,
            "type": "string"
          },
          "notes": {
            "type": "string",
            "nullable": true
          },
          "treatmentDetails": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "SignupRequestDto": {
        "required": [
          "confirmPassword",
          "email",
          "name",
          "password",
          "role"
        ],
        "type": "object",
        "properties": {
          "name": {
            "minLength": 3,
            "type": "string"
          },
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 8,
            "type": "string"
          },
          "confirmPassword": {
            "minLength": 1,
            "type": "string"
          },
          "role": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  }
